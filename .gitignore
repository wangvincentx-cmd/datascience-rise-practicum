# Secrets — never commit API keys
.env
*.env
!.env.example
.claude/settings.json

# Virtualenvs
.venv/
venv/

# Python
__pycache__/
*.py[cod]

# OS
.DS_Store
Thumbs.db

# ---------------------------------------------------------------------------
# LARGE REGENERABLE DATA
#
# GitHub hard-fails any file over 100 MB and warns over 50 MB. Everything below
# is big AND rebuildable, so it stays out of the repo. What we DO commit is the
# expensive derived output (claims + scored CSVs, tens of MB at most) — those
# cost real money and time to regenerate; raw pages cost only a re-download.
#
#   data/corpus/monthly/pages_monthly.jsonl   368 MB  <-- over GitHub's limit
#   data/corpus/monthly/pages_monthly.shard*   92 MB each (4 of them)
#   data/corpus/pages.jsonl                    47 MB
#   cache/                                    305 MB  raw API responses
#
# Rebuild with:  python src/scrape_monthly.py --stage both      (~24 h, free)
#                python src/combine_shards.py --in-dir data/corpus/monthly
#                python src/build_page_corpus.py                (from cache/)
# ---------------------------------------------------------------------------
cache/
**/data/raw/
data/corpus/

# Working/duplicate copies that occasionally appear next to the real corpus
*pages_monthly*
!data/corpus/monthly/monthly_manifest.csv
!data/corpus/monthly/monthly_denominators.csv

# Regenerable run logs
*.log

# Grading output that is partial by nature — commit a finished corpus
# deliberately with `git add -f`, never let an in-progress file slip in
data/claims/claims_graded_test.csv

# Per-model extraction experiments (regenerable, and superseded by RESULTS.md)
validation/gold_extraction/pred_*.jsonl
validation/gold_extraction/log_*.txt

# Spreadsheet working files — graders edit in Excel, but only the exported CSV
# is the artifact (binary formats can't be diffed). Reference data is exempt.
*.numbers
!data/reference/*.xlsx
